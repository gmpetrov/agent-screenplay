{
  "name": "agent-screenplay",
  "version": "0.1.0",
  "description": "Screen Studio-quality screen recordings for AI agents: write a scenario, Screenplay films it and edits it (smooth cursor, auto-zoom, callouts, voice-over).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "screenplay": "dist/cli.js",
    "agent-screenplay": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmpetrov/screenplay.git"
  },
  "keywords": [
    "screen-recording",
    "mcp",
    "ai-agents",
    "playwright",
    "demo-video",
    "screen-studio",
    "claude-code",
    "codex",
    "agent",
    "agent-screenplay"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-schema.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.0",
    "commander": "^14.0.3",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "agent-desktop": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
